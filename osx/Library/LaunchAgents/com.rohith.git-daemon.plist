<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rohith.git-daemon</string>
    <key>ProgramArguments</key>
    <array>
	<string>/bin/sh</string>
	<string>-c</string>
        <string>
TS=/Applications/Tailscale.app/Contents/MacOS/Tailscale
while ! "$TS" status >/dev/null 2>&amp;1; do sleep 5; done
IP=$("$TS" ip -4)
exec /opt/homebrew/bin/git daemon --listen="$IP" --port=9418 --base-path="$HOME/work" --export-all
        </string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/com.rohith.git-daemon.stderr.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/com.rohith.git-daemon.stdout.log</string>
</dict>
</plist>
